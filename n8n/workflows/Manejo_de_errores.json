      "position": [
        240,
        300
      ],
      "credentials": {
        "smtp": {
          "id": "credSmtpCurso001",
          "name": "SMTP del curso"
        }
      }
    }
  ],
  "connections": {
    "Error Trigger": {
      "main": [
        [
          {
            "node": "Avisar por correo",
