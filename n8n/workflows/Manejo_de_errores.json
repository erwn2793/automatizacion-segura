      "typeVersion": 1,
      "position": [
        0,
        300
      ]
    },
    {
      "parameters": {
        "fromEmail": "={{ $env.CORREO_REMITENTE }}",
        "toEmail": "={{ $env.CORREO_SOPORTE }}",
        "subject": "=[ALERTA] Fallo en {{ $json.workflow.name }}",
        "emailFormat": "html",
        "html": "=<p>Fallo una automatizacion.</p>\n<ul>\n<li><b>Workflow:</b> {{ $json.workflow.name }}</li>\n<li><b>Nodo:</b> {{ $json.execution.lastNodeExecuted }}</li>\n<li><b>Error:</b> {{ $json.execution.error.message }}</li>\n<li><b>Ejecucion:</b> <a href=\"{{ $json.execution.url }}\">{{ $json.execution.id }}</a></li>\n</ul>\n<p>Siguiente paso: revisar la ejecucion y, si el fallo vino de un cambio reciente, aplicar docs/runbook-rollback.md.</p>",
        "options": {
          "appendAttribution": false
        }
      },
      "id": "47b5ffa9-5aaa-5140-9a59-f505ef42ce4f",
