# Copiar a .env y completar. El archivo .env NUNCA se sube a Git (esta en .gitignore).

# --- Seguridad de n8n -------------------------------------------------------
# Clave que cifra las credenciales guardadas en n8n. Generarla UNA sola vez:
#   openssl rand -hex 32
# Si se pierde, las credenciales guardadas ya no se pueden descifrar.
N8N_ENCRYPTION_KEY=

# Sal para el hash del DNI (bitacora de auditoria). Generarla una vez:
#   openssl rand -hex 16
HASH_SALT=

# URL publica de n8n. Se usa en los enlaces de aprobacion del correo y en las alertas.
# En local basta localhost; si el aprobador abre el correo desde otro equipo, usar la URL publica.
WEBHOOK_URL=http://localhost:5678/

# --- UiPath Orchestrator (Automation Cloud) ---------------------------------
# Datos NO secretos. El Client ID y Secret van en la credencial OAuth2 de n8n.
UIPATH_ORG=miorganizacion
UIPATH_TENANT=DefaultTenant
# Id de la carpeta (aparece como fid= en la URL de Orchestrator)
UIPATH_FOLDER_ID=
# Key del proceso (ver uipath/README.md, paso "Obtener la Release Key")
UIPATH_RELEASE_KEY=

# --- Correos -----------------------------------------------------------------
CORREO_REMITENTE=automatizacion@midominio.com
CORREO_APROBADOR=supervisor@midominio.com
CORREO_SOPORTE=soporte@midominio.com
CORREO_ATENCION=atencion@midominio.com

# --- Bitacora de auditoria (Google Sheets) -----------------------------------
# Id del documento: la parte entre /d/ y /edit en la URL de la hoja
BITACORA_SHEET_ID=
