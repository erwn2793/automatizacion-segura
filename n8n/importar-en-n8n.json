  {
    "id": "solicitudesV2seg",
    "name": "Solicitudes v2 - segura",
    "active": false,
    "nodes": [
      {
        "parameters": {
          "httpMethod": "POST",
          "path": "v2/solicitudes",
          "authentication": "headerAuth",
          "responseMode": "responseNode",
          "options": {}
        },
        "id": "e7544ca2-4f02-5b55-bf89-ebb1a02bf790",
        "name": "Webhook Solicitudes",
        "type": "n8n-nodes-base.webhook",
        "typeVersion": 2,
        "position": [
          0,
          300
        ],
        "credentials": {
          "httpHeaderAuth": {
            "id": "credHeaderAuth01",
            "name": "Webhook Solicitudes - API Key"
          }
        },
        "webhookId": "264c6e8d-0ab4-58f0-902e-c4911ac81b7b"
      },
      {
        "parameters": {
          "jsCode": "// Version desplegada: actualizar en cada release (queda registrada en la bitacora)\nconst VERSION = 'v1.1.0';\n\nconst b = $input.first().json.body || {};\nconst errores = [];\nconst nombre = String(b.nombre || '').trim();\nconst dni = String(b.dni || '').trim();\nconst correo = String(b.correo || '').trim().toLowerCase();\nconst tipo = String(b.tipo || '').trim();\n\nif (!nombre) errores.push('Falta el nombre');\nif (!/^\\d{8}$/.test(dni)) errores.push('El DNI debe tener 8 digitos');\nif (!/^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$/.test(correo)) errores.push('Correo no valido');\nif (!tipo) errores.push('Falta el tipo de solicitud');\nif (b.consentimiento !== true && b.consentimiento !== 'true') {\n  errores.push('Falta el consentimiento para el tratamiento de datos personales');\n}\n\nreturn [{\n  json: {\n    valido: errores.length === 0,\n    errores,\n    version: VERSION,\n    correlation_id: `SOL-${$execution.id}`,\n    nombre,\n    dni,\n    correo,\n    telefono: String(b.telefono || ''),\n    tipo,\n    detalle: String(b.detalle || ''),\n    dni_mascara: dni.length === 8 ? dni.slice(0, 2) + '****' + dni.slice(-2) : '',\n  },\n}];"
        },
        "id": "56f0d53f-c7e9-5e3c-97ba-b8cef59dc65f",
        "name": "Validar datos",
        "type": "n8n-nodes-base.code",
        "typeVersion": 2,
        "position": [
          220,
          300
        ]
      },
      {
        "parameters": {
          "conditions": {
            "options": {
              "caseSensitive": true,
              "leftValue": "",
              "typeValidation": "loose"
            },
            "conditions": [
              {
                "id": "a2d150d1-82f1-5b26-a1b6-7de2908393eb",
                "leftValue": "={{ $json.valido }}",
                "rightValue": true,
                "operator": {
                  "type": "boolean",
                  "operation": "true",
                  "singleValue": true
                }
              }
            ],
            "combinator": "and"
          },
          "options": {}
        },
        "id": "98284ec6-3969-5ca1-9343-33b81e7f21da",
        "name": "Datos validos?",
        "type": "n8n-nodes-base.if",
        "typeVersion": 2,
        "position": [
          440,
          300
        ]
      },
      {
        "parameters": {
          "respondWith": "json",
          "responseBody": "={{ JSON.stringify({ ok: false, id: $json.correlation_id, errores: $json.errores }) }}",
          "options": {
            "responseCode": 400
          }
        },
        "id": "3264f43f-4855-59a9-b5bb-510bf8f994e8",
        "name": "Responder 400",
        "type": "n8n-nodes-base.respondToWebhook",
        "typeVersion": 1.1,
        "position": [
          660,
          500
        ]
      },
      {
        "parameters": {
          "jsCode": "// Solicitud rechazada por validacion: no se registra ningun dato personal\nconst s = $('Validar datos').first().json;\nreturn [{\n  json: {\n    fecha_utc: new Date().toISOString(),\n    plataforma: 'n8n',\n    workflow: $workflow.name,\n    version: s.version,\n    id_ejecucion: $execution.id,\n    correlation_id: s.correlation_id,\n    tipo: s.tipo,\n    resultado: 'invalida: ' + s.errores.join('; '),\n    dni_hash: '',\n    aprobado_por: '',\n  },\n}];"
        },
        "id": "3472d97b-539f-5ef7-beb3-6e3660f69555",
        "name": "Registro: invalida",
        "type": "n8n-nodes-base.code",
        "typeVersion": 2,
        "position": [
          880,
          500
        ]
      },
      {
        "parameters": {
          "action": "hash",
          "type": "SHA256",
          "value": "={{ $env.HASH_SALT }}{{ $json.dni }}",
          "dataPropertyName": "dni_hash"
        },
        "id": "c66b024d-cdcb-54cf-8708-5b942e84e6c5",
        "name": "Hash DNI",
        "type": "n8n-nodes-base.crypto",
        "typeVersion": 1,
        "position": [
          660,
          200
        ]
      },
      {
        "parameters": {
          "respondWith": "json",
          "responseBody": "={{ JSON.stringify({ ok: true, id: $json.correlation_id, mensaje: 'Recibimos tu solicitud. Este proceso es automatico; para hablar con una persona escribe a ' + $env.CORREO_ATENCION }) }}",
          "options": {
            "responseCode": 202
          }
        },
        "id": "d253f814-7a5a-5740-b01a-dffca3b89045",
        "name": "Responder 202",
        "type": "n8n-nodes-base.respondToWebhook",
        "typeVersion": 1.1,
        "position": [
          880,
          200
        ]
      },
      {
        "parameters": {
          "conditions": {
            "options": {
              "caseSensitive": true,
              "leftValue": "",
              "typeValidation": "loose"
            },
            "conditions": [
              {
                "id": "e7d76d0b-c976-5cff-a594-8de909260b7b",
                "leftValue": "={{ $json.tipo }}",
                "rightValue": "Reembolso",
                "operator": {
                  "type": "string",
                  "operation": "equals"
                }
              }
            ],
            "combinator": "and"
          },
          "options": {}
        },
        "id": "61f1dbe8-b7d9-52ef-8631-e840e4ddf69c",
        "name": "Requiere aprobacion?",
        "type": "n8n-nodes-base.if",
        "typeVersion": 2,
        "position": [
          1100,
          200
        ]
      },
      {
        "parameters": {
          "fromEmail": "={{ $env.CORREO_REMITENTE }}",
          "toEmail": "={{ $env.CORREO_APROBADOR }}",
          "subject": "=Aprobacion requerida: {{ $json.correlation_id }}",
          "emailFormat": "html",
          "html": "=<p>Hay una solicitud que requiere revision humana antes de procesarse.</p>\n<ul>\n<li><b>ID:</b> {{ $json.correlation_id }}</li>\n<li><b>Tipo:</b> {{ $json.tipo }}</li>\n<li><b>DNI:</b> {{ $json.dni_mascara }}</li>\n<li><b>Detalle:</b> {{ $json.detalle }}</li>\n</ul>\n<p>\n<a href=\"{{ $execution.resumeUrl }}{{ $execution.resumeUrl.includes('?') ? '&' : '?' }}decision=aprobar&aprobador={{ encodeURIComponent($env.CORREO_APROBADOR) }}\">APROBAR</a>\n&nbsp;|&nbsp;\n<a href=\"{{ $execution.resumeUrl }}{{ $execution.resumeUrl.includes('?') ? '&' : '?' }}decision=rechazar&aprobador={{ encodeURIComponent($env.CORREO_APROBADOR) }}\">RECHAZAR</a>\n</p>\n<p>Si no respondes en 24 horas, la solicitud queda registrada como sin respuesta.</p>",
          "options": {
            "appendAttribution": false
          }
        },
        "id": "5ae01dd3-dae8-5cd6-bbe5-249285610217",
        "name": "Pedir aprobacion",
        "type": "n8n-nodes-base.emailSend",
        "typeVersion": 2.1,
        "position": [
          1320,
          60
        ],
        "credentials": {
          "smtp": {
            "id": "credSmtpCurso001",
            "name": "SMTP del curso"
          }
        }
      },
      {
        "parameters": {
          "resume": "webhook",
          "httpMethod": "GET",
          "limitWait": true,
          "limitType": "afterTimeInterval",
          "resumeAmount": 24,
          "resumeUnit": "hours",
          "options": {}
        },
        "id": "01cd206d-f874-516c-b9b6-fae3aca68455",
        "name": "Esperar decision",
        "type": "n8n-nodes-base.wait",
        "typeVersion": 1.1,
        "position": [
          1540,
          60
        ],
        "webhookId": "6cac57cc-0ebd-59fe-8e19-181955ed8ce6"
      },
      {
        "parameters": {
          "conditions": {
            "options": {
              "caseSensitive": true,
              "leftValue": "",
              "typeValidation": "loose"
            },
            "conditions": [
              {
                "id": "340a58ad-3962-5391-b262-54ae1a90c313",
                "leftValue": "={{ $json.query && $json.query.decision }}",
                "rightValue": "aprobar",
                "operator": {
                  "type": "string",
                  "operation": "equals"
                }
              }
            ],
            "combinator": "and"
          },
          "options": {}
        },
        "id": "b2e87f55-63e2-51be-8270-65d067d9bfed",
        "name": "Aprobada?",
        "type": "n8n-nodes-base.if",
        "typeVersion": 2,
        "position": [
          1760,
          60
        ]
      },
      {
        "parameters": {
          "jsCode": "// Fila para la bitacora de auditoria: sin nombre, DNI, correo ni telefono\nconst s = $('Hash DNI').first().json;\nconst q = $input.first().json.query || {};\nconst decision = q.decision || '';\nconst aprobadoPor = decision ? (q.aprobador || 'desconocido') : '';\nreturn [{\n  json: {\n    fecha_utc: new Date().toISOString(),\n    plataforma: 'n8n',\n    workflow: $workflow.name,\n    version: s.version,\n    id_ejecucion: $execution.id,\n    correlation_id: s.correlation_id,\n    tipo: s.tipo,\n    resultado: decision === 'rechazar' ? 'rechazada' : 'sin_respuesta',\n    dni_hash: s.dni_hash,\n    aprobado_por: aprobadoPor,\n  },\n}];"
        },
        "id": "bff7e491-a191-5b60-b3bb-5ed72c4389a2",
        "name": "Registro: rechazada",
        "type": "n8n-nodes-base.code",
        "typeVersion": 2,
        "position": [
          1980,
          160
        ]
      },
      {
        "parameters": {
          "method": "POST",
          "url": "=https://cloud.uipath.com/{{ $env.UIPATH_ORG }}/{{ $env.UIPATH_TENANT }}/orchestrator_/odata/Jobs/UiPath.Server.Configuration.OData.StartJobs",
          "authentication": "genericCredentialType",
          "genericAuthType": "oAuth2Api",
          "sendHeaders": true,
          "headerParameters": {
            "parameters": [
              {
                "name": "X-UIPATH-OrganizationUnitId",
                "value": "={{ $env.UIPATH_FOLDER_ID }}"
              }
            ]
          },
          "sendBody": true,
          "specifyBody": "json",
          "jsonBody": "={{ JSON.stringify({ startInfo: { ReleaseKey: $env.UIPATH_RELEASE_KEY, Strategy: 'ModernJobsCount', JobsCount: 1, InputArguments: JSON.stringify({ in_CorrelationId: $('Hash DNI').item.json.correlation_id, in_Tipo: $('Hash DNI').item.json.tipo, in_Dni: $('Hash DNI').item.json.dni, in_DniMascara: $('Hash DNI').item.json.dni_mascara, in_Detalle: $('Hash DNI').item.json.detalle }) } }) }}",
          "options": {}
        },
        "id": "a4e56bbd-0a9e-570e-9e44-a3e67bd40ebe",
        "name": "Iniciar robot UiPath",
        "type": "n8n-nodes-base.httpRequest",
        "typeVersion": 4.2,
        "position": [
          1980,
          -60
        ],
        "credentials": {
          "oAuth2Api": {
            "id": "credUiPathOAuth1",
            "name": "UiPath Orchestrator (OAuth2)"
          }
        }
      },
      {
        "parameters": {
          "jsCode": "// Fila para la bitacora de auditoria: sin nombre, DNI, correo ni telefono\nconst s = $('Hash DNI').first().json;\nlet aprobadoPor = 'no requerida';\ntry {\n  const q = $('Esperar decision').first().json.query || {};\n  if (q.decision) aprobadoPor = q.aprobador || 'desconocido';\n} catch (e) {\n  // la solicitud no paso por aprobacion\n}\nreturn [{\n  json: {\n    fecha_utc: new Date().toISOString(),\n    plataforma: 'n8n',\n    workflow: $workflow.name,\n    version: s.version,\n    id_ejecucion: $execution.id,\n    correlation_id: s.correlation_id,\n    tipo: s.tipo,\n    resultado: 'enviada_a_robot',\n    dni_hash: s.dni_hash,\n    aprobado_por: aprobadoPor,\n  },\n}];"
        },
        "id": "c976363a-35dd-5ac0-a988-03d1cc232be3",
        "name": "Registro: enviada al robot",
